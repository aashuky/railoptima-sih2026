{
  "name": "railoptima-root",
  "version": "1.0.0",
  "private": true,
  "description": "RailOptima - AI-Powered Automatic Block Planning for Indian Railways",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "server": "cd server && npm start",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
